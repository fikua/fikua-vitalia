# Authentik for Clínica Vitalia. Copy to .env (git-ignored) and fill in.
# `make authentik-env` writes a local .env with random secrets and the
# addresses of `make demo`.

# --- Authentik itself
PG_PASS=
AUTHENTIK_SECRET_KEY=
# First admin account (akadmin), created on the first start.
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_EMAIL=admin@vitalia.example
COMPOSE_PORT_HTTP=9000

# --- The clinic (blueprints/vitalia.yaml reads these)
# Public address of Clínica Vitalia: builds its redirect URIs.
VITALIA_URL=http://localhost:8080
# OIDC client of Vitalia in Authentik (VITALIA_OIDC_CLIENT_SECRET and
# VITALIA_STAFF_OIDC_CLIENT_SECRET on the Vitalia side).
VITALIA_CLIENT_ID=vitalia
VITALIA_CLIENT_SECRET=
# OIDC client of the professional area (physicians, straight to DoctorID):
# VITALIA_OIDC_CLIENT_ID / VITALIA_OIDC_CLIENT_SECRET on the Vitalia side.
VITALIA_PRO_CLIENT_ID=vitalia-profesional
VITALIA_PRO_CLIENT_SECRET=
# API token of the vitalia-directory service account: Vitalia provisions the
# physicians HR registers with it (VITALIA_DIRECTORY_TOKEN on both sides).
VITALIA_DIRECTORY_TOKEN=
# Password of the HR test account "rrhh" (group "Vitalia RRHH").
VITALIA_HR_PASSWORD=

# --- Enrolment service, SCIM 2.0 (server to server, from the containers)
ENROLMENT_SCIM_URL=http://host.docker.internal:8090/scim/v2
ENROLMENT_SCIM_TOKEN=

# --- DoctorID identity provider (CGCOM Verifier), federated as a source.
# The authorize URL is opened by the browser; the token and JWKS URLs are
# called from the containers, so locally they go through host.docker.internal.
DOCTORID_CLIENT_ID=authentik-vitalia
DOCTORID_CLIENT_SECRET=
DOCTORID_AUTHORIZE_URL=http://localhost:8091/authorize
DOCTORID_TOKEN_URL=http://host.docker.internal:8091/token
DOCTORID_JWKS_URL=http://host.docker.internal:8091/jwks
DOCTORID_SCOPES=doctorid
