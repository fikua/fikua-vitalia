# Clínica Vitalia — configuration. Copy to a file OUTSIDE the repo and fill in.
# Never commit real values.

# Enrolment API base URL (server-to-server).
VITALIA_ADAPTER_BASE_URL=
# Bearer token for the API (phase 1: static). Empty sends no token.
VITALIA_ADAPTER_TOKEN=
VITALIA_ADAPTER_TIMEOUT=15s

# Webhook secret given to the platform out of band (>= 32 characters).
VITALIA_WEBHOOK_SECRET=
# Accepted clock skew of the signature timestamp, both directions.
VITALIA_SIGNATURE_TOLERANCE=5m
# Read the enrolment (GET) after each applied webhook.
VITALIA_REFRESH_ON_WEBHOOK=true

# Operator UI credentials (test account).
VITALIA_UI_USER=
VITALIA_UI_PASSWORD=
VITALIA_COOKIE_SECURE=true

VITALIA_LISTEN_ADDR=:8080
VITALIA_DB_PATH=/data/vitalia.db
