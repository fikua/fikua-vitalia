# Clínica Vitalia — configuration. Copy to a file OUTSIDE the repo and fill in.
# Never commit real values.

# Enrolment API base URL (server-to-server).
VITALIA_ADAPTER_BASE_URL=
# Bearer token for the API (phase 1: static). Empty sends no token.
VITALIA_ADAPTER_TOKEN=
VITALIA_ADAPTER_TIMEOUT=15s

# CGCOM platform credential (private_key_jwt, RFC 7523). When the token URL
# is set, the API token is obtained with it and VITALIA_ADAPTER_TOKEN is
# ignored. Generate the key where it will live:
#   KEY=$(cgcomkey) && echo "VITALIA_CGCOM_SIGNING_KEY=$KEY" >> .env && echo "$KEY" | cgcomkey -jwk
# and send CGCOM only the printed public JWK.
VITALIA_CGCOM_TOKEN_URL=
VITALIA_CGCOM_CLIENT_ID=
VITALIA_CGCOM_SIGNING_KEY=
# Optional: assertion audience (default: the token URL) and scope.
VITALIA_CGCOM_TOKEN_AUDIENCE=
VITALIA_CGCOM_TOKEN_SCOPE=

# Webhook secret given to the platform out of band (>= 32 characters).
VITALIA_WEBHOOK_SECRET=
# Accepted clock skew of the signature timestamp, both directions.
VITALIA_SIGNATURE_TOLERANCE=5m
# Read the enrolment (GET) after each applied webhook.
VITALIA_REFRESH_ON_WEBHOOK=true

# Public address of the clinic (builds the OIDC redirect URI).
VITALIA_PUBLIC_URL=https://vitalia.fikua.com

# Physicians' login (OIDC relying party). Leave the issuer empty to disable it.
# Either the DoctorID identity provider directly (private_key_jwt, signing key
# below) or the clinic's Authentik, which federates DoctorID (client secret).
VITALIA_OIDC_ISSUER=
VITALIA_OIDC_CLIENT_ID=vitalia
VITALIA_OIDC_SCOPES=openid profile doctorid
# Optional essential level, e.g. http://eidas.europa.eu/LoA/high
VITALIA_OIDC_ACR=
# EC P-256 private key for private_key_jwt, base64 PKCS#8 DER (or PEM):
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 -w0   (macOS: base64)
# Its public key is served at /.well-known/jwks.json.
VITALIA_OIDC_SIGNING_KEY=
# With Authentik: its client secret instead of the signing key.
VITALIA_OIDC_CLIENT_SECRET=

# Management area sign-in with the clinic's Authentik. Empty disables it.
VITALIA_STAFF_OIDC_ISSUER=
VITALIA_STAFF_OIDC_CLIENT_ID=vitalia
VITALIA_STAFF_OIDC_CLIENT_SECRET=
# Group the ID Token's "groups" claim must list.
VITALIA_STAFF_GROUP=Vitalia RRHH

# Management area test account (username and password). Optional when the
# staff sign-in above is configured.
VITALIA_UI_USER=
VITALIA_UI_PASSWORD=
VITALIA_COOKIE_SECURE=true

VITALIA_LISTEN_ADDR=:8080
VITALIA_DB_PATH=/data/vitalia.db
